{
  "name": "claude-code-dashboard",
  "version": "1.0.0",
  "description": "Claude Code 会话仪表板 — 浏览、搜索和分析你的 AI 对话记录",
  "type": "module",
  "bin": {
    "claude-dashboard": "./dist/bin/cli.cjs"
  },
  "files": [
    "dist/bin",
    "dist/server",
    "dist/client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "node scripts/build.mjs",
    "build:standalone": "node scripts/build.mjs && node scripts/build-standalone.mjs",
    "start": "node dist/bin/cli.cjs",
    "prepublishOnly": "npm run build"
  },
  "pkg": {
    "assets": [
      "dist/client/**/*"
    ],
    "scripts": [
      "dist/bin/cli.js",
      "dist/server/**/*.js"
    ]
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.62.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "highlight.js": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "rehype-highlight": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "claude",
    "dashboard",
    "cli",
    "ai",
    "conversation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/he-jianbo/claude-dashboard"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
